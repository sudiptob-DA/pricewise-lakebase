# Copy to .env for local development. NEVER commit the real .env.
DATABRICKS_HOST=https://dbc-9d25a17d-f58c.cloud.databricks.com
DATABRICKS_CONFIG_PROFILE=DEFAULT

# SQL warehouse for lakehouse queries
WAREHOUSE_ID=64d934278b5c472d

# Unity Catalog target
UC_CATALOG=hackathon
UC_SCHEMA=data_axle

# Lakebase (Autoscaling project — filled in after provisioning / from notebook 04)
LAKEBASE_PROJECT=pricewise-db
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_ENDPOINT=          # projects/<id>/branches/<id>/endpoints/<id>  (printed by notebook 04)
LAKEBASE_HOST=              # endpoint host (printed by notebook 04)
LAKEBASE_PORT=5432

# External enrichment APIs (no auth required)
FX_API_BASE=https://api.frankfurter.dev/v1
HOLIDAYS_API_BASE=https://date.nager.at/api/v3

# Model Serving embedding endpoint
EMBEDDING_ENDPOINT=databricks-gte-large-en
